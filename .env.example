# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME="Artha AI Finance Advisor"
APP_ENV=development
# MUST be a 64-char random hex string in production — see instructions above
SECRET_KEY=REPLACE_ME_WITH_64_CHAR_HEX_STRING
DEBUG=true

# CORS Domains — Must exactly match the frontend URL
# Local dev: http://localhost:5173,http://localhost:3000
# Railway deployed: http://localhost:5173,https://your-frontend-app.up.railway.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────────────────
# Dev (SQLite — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./finance_advisor.db

# Prod (Supabase Postgres):
# Go to: Supabase Dashboard → Settings → Database → URI
# Replace 'postgresql://' with 'postgresql+asyncpg://'
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.[PROJECT-ID].supabase.co:5432/postgres

# ── Supabase ────────────────────────────────────────────────────────────────────
# Go to: Supabase Dashboard → Settings → API
# Both values are required if you use Supabase auth or storage features.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# ── AI — Google Gemini ──────────────────────────────────────────────────────────
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-key-here
# Working free-tier models (March 2026):
#   gemini-2.5-flash-lite  ← recommended (latest 2.5, free quota)
#   gemini-2.0-flash       ← fallback
#   gemini-2.5-pro         ← requires paid quota
GEMINI_MODEL=gemini-2.5-flash-lite

# ── Optional tuning ────────────────────────────────────────────────────────────
MAX_TOKENS=1000
TEMPERATURE=0.4
